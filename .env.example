APP_NAME=ProofWork
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=proofwork_saas
DB_USERNAME=root
DB_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD="your_app_password"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your@gmail.com
MAIL_FROM_NAME="ProofWork"

# Stripe
STRIPE_KEY=pk_test_xxx
STRIPE_SECRET=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_AGENCY=price_yyy

# OAuth - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

# OAuth - Google (for Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Linear OAuth
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Claude API (AI summaries)
ANTHROPIC_API_KEY=

# ProofWork admin
PROOFWORK_ADMIN_EMAIL=your@gmail.com
PROOFWORK_ADMIN_PASSWORD=changeme

# PDF digital signature certificate
# In production, store these files outside public/ and keep the private key secret.
PROOFWORK_PDF_CERTIFICATE_PATH=
PROOFWORK_PDF_PRIVATE_KEY_PATH=
PROOFWORK_PDF_PRIVATE_KEY_PASSWORD=

# Plausible analytics (optional - set after deployment)
# PLAUSIBLE_DOMAIN=proofwork.app

QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
